# backend/.env
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production

# Postgres dentro de Docker
DATABASE_URL=postgresql://postgres:postgres@db:5432/quinchodb?schema=public

# URL interna (Docker) del backend y externa (frontend)
API_BASE_URL=http://backend:3000
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Webhook público/interno (usa el interno por ahora en Docker)
MP_WEBHOOK_URL=http://backend:3000/api/mp/webhook

# ====== TRANSBANK (Webpay Plus) ======
TBK_ENV=TEST
TBK_RETURN_URL=http://localhost:3000/api/tbk/return   # endpoint del backend para el commit
TBK_FINAL_URL=http://localhost:5173/pago/ok           # adónde rediriges al frontend post-commit

# ====== SMTP (correo) ======
SMTP_HOST=smtp.gmail.com         # proveedor SMTP (ej: Gmail/SES/Sendinblue/etc.)
SMTP_PORT=465                   # 587 (STARTTLS) o 465 (TLS)
SMTP_USER=jfsanchez20044@gmail.com   # usuario SMTP
SMTP_PASS=heshgsoqcbvfazed # password o App Password
SMTP_FROM="Quincho Alto Bonito <no-reply@tudominio.cl>"